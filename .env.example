# -------------------------------------------------------------
# TESTORA Environment Variables Template
# Copy this file to .env and customize for your local setup
# -------------------------------------------------------------

# Application
APP_NAME=TESTORA
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./testora.db
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/testora
DATABASE_URL=sqlite+aiosqlite:///./testora.db

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_NAME=testora_session

# AI Configuration (Anthropic API - backend only)
ANTHROPIC_API_KEY=

# File Storage / Attachments
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
